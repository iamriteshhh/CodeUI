# Auto detect text files and perform LF normalization
* text=auto
installer/dist/*.AppImage filter=lfs diff=lfs merge=lfs -text
installer/dist/*.exe filter=lfs diff=lfs merge=lfs -text
installer/dist/*.msi filter=lfs diff=lfs merge=lfs -text
installer/dist/*.dmg filter=lfs diff=lfs merge=lfs -text
installer/dist/*.deb filter=lfs diff=lfs merge=lfs -text
installer/dist/SHA256SUMS.txt -text
