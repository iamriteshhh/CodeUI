# Rust
/target/
target/
**/*.rs.bk

# Frontend
node_modules/
dist/
.vite/

# Tauri build output
src-tauri/target/

# Scratch & temporary execution artifacts
.codeui-scratch/
*.codeui-tmp

# Editors & OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Local settings written at runtime
*.json.tmp

# Tauri generated schemas
src-tauri/gen/

# Installer packages & binaries (distributed via GitHub Releases)
installer/*.exe
installer/*.msi
installer/*.deb
installer/*.dmg
installer/*.AppImage
installers/
*.exe
*.msi
*.deb
*.dmg
*.AppImage

# Salivo SDK binaries are bundled by CI (release.yml), never committed
src-tauri/resources/salivo-sdk/

# Installers are committed with Git LFS (see .gitattributes); the AppImage exceeds GitHub's 100 MB file limit.
!installer/dist/
!installer/dist/*

# Environment, secrets, private keys & credentials (never commit to public repo)
.env
.env.*
*.env
*.pem
*.key
*.p12
*.pfx
id_rsa
id_ed25519
*.secret
credentials.json

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Presentation scripts & decks (repository policy enforces zero Python)
*.py
*.pptx
